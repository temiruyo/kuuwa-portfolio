        <!-- 化妆品 -->
        <a class="ecom-card scale-in" href="detail/化妆品.html">
            <img class="ecom-card-img" src="images/电商/主图2_场景图.jpg" alt="化妆品详情模板">
            <div class="ecom-card-body">
                <div class="ecom-card-title">💄 化妆品详情模板</div>
                <div class="ecom-card-desc">主图5张 · 详情页长图 · 完整视觉方案</div>
                <span class="ecom-card-link">查看完整详情页 →</span>
            </div>
        </a>
    </div>
<!-- 经历 -->
    <div class="gap"></div>
    <div class="card exp-section fade-in">
        <div class="section-label">经历</div>
        <div class="timeline">
            <div class="timeline-item fade-in-left"><div class="timeline-dot"></div><div class="timeline-date">2022 — 至今</div><div class="timeline-title">自由插画师</div><div class="timeline-sub">B站接单，商业插画委托，抱枕立绘、同人插画等约稿</div></div>
            <div class="timeline-item fade-in-left"><div class="timeline-dot"></div><div class="timeline-date">2026</div><div class="timeline-title">电商视觉设计</div><div class="timeline-sub">云感沙发、床头柜、化妆品详情页等独立项目</div></div>
            <div class="timeline-item fade-in-left"><div class="timeline-dot"></div><div class="timeline-date">2019 — 2022</div><div class="timeline-title">江西陶瓷工艺美术职业技术学院</div><div class="timeline-sub">移动互联网UI设计 · 专科</div></div>
        </div>
    </div>

    <!-- 联系 -->
    <div class="card contact-section fade-in">
        <div class="section-label">联系我</div>
        <div class="contact-row">
            <a href="mailto:2943436946@qq.com" class="contact-btn"><span>✉️</span> 邮件联系</a>
            <a href="https://space.bilibili.com" class="contact-btn" target="_blank"><span>📺</span> B站主页</a>
        </div>
    </div>
</div>

<!-- Lightbox -->
<div class="lightbox" id="lightbox">
    <span class="lightbox-close" onclick="closeLB()">&times;</span>
    <img id="lb-img" src="" alt="查看大图" draggable="false">
    <div class="zoom-controls">
        <button class="zoom-btn" onclick="zoomIn()">+</button>
        <span class="zoom-info" id="zoom-info">100%</span>
        <button class="zoom-btn" onclick="zoomOut()">−</button>
        <button class="zoom-btn" onclick="zoomReset()" style="font-size:14px;">↺</button>
    </div>
</div>

<script>
var lbImg = null;
var fullSrc = '';
var thumbSrc = '';
var scale = 1;
var panX = 0, panY = 0;
var isDragging = false;
var dragStartX, dragStartY;

function openLB(el) {
    var img = el.querySelector('img');
    if (!img) return;
    lbImg = document.getElementById('lb-img');
    thumbSrc = img.src;
    fullSrc = el.getAttribute('data-full') || img.src;
    lbImg.src = thumbSrc;
    scale = 1; panX = 0; panY = 0;
    updateTransform();
    document.getElementById('lightbox').classList.add('active');
}

function updateTransform() {
    if (!lbImg) return;
    lbImg.style.transform = 'translate(' + panX + 'px, ' + panY + 'px) scale(' + scale + ')';
    document.getElementById('zoom-info').textContent = Math.round(scale * 100) + '%';
}

function zoomIn() {
    scale = Math.min(scale * 1.3, 5);
    if (scale > 1 && lbImg.src !== fullSrc) lbImg.src = fullSrc;
    updateTransform();
}

function zoomOut() {
    scale = Math.max(scale / 1.3, 0.5);
    if (scale <= 1) { panX = 0; panY = 0; lbImg.src = thumbSrc; }
    updateTransform();
}

function zoomReset() {
    scale = 1; panX = 0; panY = 0;
    lbImg.src = thumbSrc;
    updateTransform();
}

function closeLB() {
    document.getElementById('lightbox').classList.remove('active');
    scale = 1; panX = 0; panY = 0;
}

// Mouse events
document.getElementById('lb-img').addEventListener('mousedown', function(e) {
    if (scale <= 1) return;
    isDragging = true;
    dragStartX = e.clientX - panX;
    dragStartY = e.clientY - panY;
    e.preventDefault();
});

document.addEventListener('mousemove', function(e) {
    if (!isDragging) return;
    panX = e.clientX - dragStartX;
    panY = e.clientY - dragStartY;
    updateTransform();
});

document.addEventListener('mouseup', function() { isDragging = false; });

// Double click to toggle zoom
document.getElementById('lb-img').addEventListener('dblclick', function(e) {
    e.preventDefault();
    e.stopPropagation();
    if (scale > 1) {
        scale = 1; panX = 0; panY = 0;
        lbImg.src = thumbSrc;
    } else {
        scale = 2;
        lbImg.src = fullSrc;
    }
    updateTransform();
});

// Scroll wheel zoom
document.getElementById('lightbox').addEventListener('wheel', function(e) {
    e.preventDefault();
    if (e.deltaY < 0) {
        scale = Math.min(scale * 1.1, 5);
        if (scale > 1 && lbImg.src !== fullSrc) lbImg.src = fullSrc;
    } else {
        scale = Math.max(scale / 1.1, 0.5);
        if (scale <= 1) { panX = 0; panY = 0; lbImg.src = thumbSrc; }
    }
    updateTransform();
});

// Touch pinch zoom
var touchDist = 0, touchScale = 1;
document.getElementById('lightbox').addEventListener('touchstart', function(e) {
    if (e.touches.length === 2) {
        touchDist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
        touchScale = scale;
    } else if (e.touches.length === 1 && scale > 1) {
        isDragging = true;
        dragStartX = e.touches[0].clientX - panX;
        dragStartY = e.touches[0].clientY - panY;
    }
});

document.getElementById('lightbox').addEventListener('touchmove', function(e) {
    e.preventDefault();
    if (e.touches.length === 2) {
        var d = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
        scale = Math.max(0.5, Math.min(5, touchScale * (d / touchDist)));
        if (scale > 1 && lbImg.src !== fullSrc) lbImg.src = fullSrc;
        updateTransform();
    } else if (isDragging && e.touches.length === 1) {
        panX = e.touches[0].clientX - dragStartX;
        panY = e.touches[0].clientY - dragStartY;
        updateTransform();
    }
});

document.getElementById('lightbox').addEventListener('touchend', function() { isDragging = false; });

// Keyboard
document.addEventListener('keydown', function(e) {
    if (!document.getElementById('lightbox').classList.contains('active')) return;
    if (e.key === 'Escape') closeLB();
    if (e.key === '+' || e.key === '=') zoomIn();
    if (e.key === '-') zoomOut();
    if (e.key === '0') zoomReset();
});

// 滚动动画
(function() {
    var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
            if (entry.isIntersecting) {
                entry.target.classList.add('visible');
            }
        });
    }, { threshold: 0.1 });

    document.querySelectorAll('.fade-in, .fade-in-left, .fade-in-right, .scale-in').forEach(function(el) {
        observer.observe(el);
    });
})();


// 保存滚动位置
window.addEventListener('beforeunload', function() {
    localStorage.setItem('scrollPos', window.scrollY);
});

// 恢复滚动位置
(function() {
    var pos = localStorage.getItem('scrollPos');
    if (pos) {
        window.scrollTo(0, parseInt(pos));
        localStorage.removeItem('scrollPos');
    }
})();

</script>

</body>
</html>